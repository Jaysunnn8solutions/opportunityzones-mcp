# Copy to .env.local and fill in. .env.local is gitignored (see .gitignore:
# ".env*" with only this file re-included) and must never be committed.
#
# Values already set in the process environment win over the file, so CI and
# Claude Code cloud sessions can inject these as secrets without a file.
#
# Never paste a real key into an issue, PR, commit, chat or log line. Every
# client that puts a key in a URL must run the URL through `redact` before
# logging or throwing it.

# ---------------------------------------------------------------------------
# Keys that are required for the sources that use them
# ---------------------------------------------------------------------------

# U.S. Census Bureau API: ACS, decennial, TIGERweb-adjacent lookups.
# Free, instant: https://api.census.gov/data/key_signup.html
# Authenticates by query string, so it is redacted from every log line.
CENSUS_API_KEY=

# HUD USER API: Fair Market Rents and Small Area FMRs.
# Free signup: https://www.huduser.gov/hudapi/public/register
# Sent as a bearer token.
HUD_USER_API_TOKEN=

# Foursquare Open Source Places (Apache-2.0), queried remotely and never
# bulk-downloaded. The access method has changed between releases (Hugging Face
# gated dataset vs. Foursquare's Places Portal / Iceberg catalog). Fill in
# whichever the current release at https://opensource.foursquare.com/os-places/
# requires and leave the other blank.
HF_TOKEN=
FSQ_PORTAL_TOKEN=

# ---------------------------------------------------------------------------
# No key needed (listed so every external API is accounted for in one place)
# ---------------------------------------------------------------------------
# Census Geocoder, TIGERweb, LEHD/LODES     census.gov
# CFPB HMDA Data Browser API                ffiec.cfpb.gov
# EPA Envirofacts / ACRES / SEMS            epa.gov
# FEMA National Flood Hazard Layer (REST)   hazards.fema.gov
# USGS Seismic Design Maps                  earthquake.usgs.gov
# FHWA HPMS via NTAD (ArcGIS REST)          geo.dot.gov
# CMS Provider Data                         data.cms.gov
# NCES EDGE / IPEDS locations               nces.ed.gov
# HUD QCT/DDA (HUD USER / HUD open data)    huduser.gov
# CDFI Fund NMTC and OZ lists               cdfifund.gov
# Treasury OZ transparency files            home.treasury.gov

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Point the pipeline at an env file you already have instead of this one, so
# one key serves several projects without being copied:
#   CENSUS_ENV_FILE=../atl-mcp/.env.local npm run pipeline
# CENSUS_ENV_FILE=
