# Copy to .env.local and fill in. .env.local is gitignored (see .gitignore:
# ".env*" with only this file re-included) and must never be committed.
#
# Values already set in the process environment win over the file, so CI and
# Claude Code cloud sessions can inject these as secrets without a file.
#
# Never paste a real key into an issue, PR, commit, chat or log line. Every
# client that puts a key in a URL must run the URL through `redact` before
# logging or throwing it.

# ---------------------------------------------------------------------------
# Keys that are required for the sources that use them
# ---------------------------------------------------------------------------

# U.S. Census Bureau API: ACS, decennial, Quarterly Workforce Indicators.
# Free, instant: https://api.census.gov/data/key_signup.html
# Authenticates by query string, so it is redacted from every log line.
CENSUS_API_KEY=

# Foursquare Open Source Places (Apache-2.0), queried remotely and never
# bulk-downloaded. Since Oct 2025 it is served from an Iceberg REST catalog
# behind the Foursquare Places Portal. Free account, then generate a token:
#   https://places.foursquare.com/  (code snippets under the OS Places dataset)
# Sent as a bearer token to the catalog.
FSQ_PORTAL_TOKEN=

# BLS Public Data API v2: local area unemployment (LAUS).
# Free signup: https://data.bls.gov/registrationEngine/
# Sent as `registrationkey` in the POST body, never in a URL. Without it the
# keyless v1 API allows only 25 requests a day.
BLS_API_KEY=

# ---------------------------------------------------------------------------
# No key needed (listed so every external API is accounted for in one place)
# ---------------------------------------------------------------------------
# Census Geocoder, TIGERweb, LEHD/LODES     census.gov
# Census Building Permits Survey files      census.gov
# BLS QCEW open data files                  data.bls.gov
# CFPB HMDA national loan-level files       files.ffiec.cfpb.gov
# EPA Envirofacts / ACRES / SEMS            geopub.epa.gov
# FEMA National Flood Hazard Layer (REST)   hazards.fema.gov
# USGS Seismic Design Maps                  earthquake.usgs.gov
# USFS Wildfire Risk to Communities         imagery.geoplatform.gov (then apps.fs.usda.gov)
# FHWA HPMS via NTAD (ArcGIS REST)          geo.dot.gov
# CMS Provider Data                         data.cms.gov
# NCES EDGE postsecondary locations         services1.arcgis.com (NCES)
# HUD QCT, DDA and Small Area FMRs          services.arcgis.com (HUD's own
#   account; huduser.gov blocks scripts, so the HUD USER API is not used)
# CDFI Fund NMTC and OZ lists               cdfifund.gov
# Treasury OZ transparency files            home.treasury.gov

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Point the pipeline at an env file you already have instead of this one, so
# one key serves several projects without being copied:
#   CENSUS_ENV_FILE=../atl-mcp/.env.local npm run pipeline
# CENSUS_ENV_FILE=

# Optional free accounts, hosted API limits, and exports (see docs/ACCESS_IMPLEMENTATION.md).
# Development defaults to localhost/127.0.0.1 and .runtime/access.sqlite.
# Use localhost in your browser for passkey registration.
# Production requires a stable HTTPS origin and private persistent storage.
# OZ_ORIGIN=https://your-domain.example
# Vercel/Neon: set DATABASE_URL as a Production secret in the host dashboard.
# Use the pooled PostgreSQL URI. Never prefix it with NEXT_PUBLIC_ or commit its value.
# DATABASE_URL=
# Without DATABASE_URL, SQLite is supported only on one persistent host (not Vercel):
# OZ_STORAGE_PATH=/private/persistent/opportunityzones/access.sqlite
# OZ_SINGLE_HOST=1
# Set only if your trusted proxy overwrites this header, stripping user-supplied values.
# OZ_TRUSTED_IP_HEADER=
# Set to 1 only after verifying edge header overwrite and direct-origin protection.
# OZ_TRUSTED_PROXY_VERIFIED=
# Exact account IDs, comma-separated; server-only. Never automatically enroll the first signup.
# OZ_OPERATOR_ACCOUNT_IDS=
# OZ_SIGNUP_PAUSED=1
# OZ_EXPORTS_PAUSED=1
# OZ_LIVE_PAUSED=1
# Unknown provider quotas default OFF in production. Verify shared-key usage first.
# OZ_SOURCE_CENSUSGEOCODER_DAILY=100
# OZ_SOURCE_CENSUSQWI_DAILY=100
# OZ_SOURCE_FEMANFHL_DAILY=50
# Enable browser OAuth setup only after validating the public HTTPS origin and client compatibility.
OZ_OAUTH_ENABLED=
# Emergency pause for the MCP endpoint; website browsing remains separate.
OZ_MCP_PAUSED=
