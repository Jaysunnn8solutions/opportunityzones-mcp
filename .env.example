# Needed only to rebuild the data with `npm run pipeline`. The deployed app and
# the MCP server read the committed files under data/ and need no credentials.
#
# Free, instant signup: https://api.census.gov/data/key_signup.html
# The Census API authenticates by query string, so the pipeline redacts this
# value from every log line and error message it emits.
CENSUS_API_KEY=your_census_api_key_here

# Alternatively, leave this file out and point the pipeline at an env file you
# already have, so one key serves several projects without being copied:
#   CENSUS_ENV_FILE=../atl-mcp/.env.local npm run pipeline
