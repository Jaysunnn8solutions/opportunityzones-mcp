# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the free Census API key lives here and must never be committed
.env*
!.env.example

# vercel
.vercel

# pipeline raw downloads, ~2 GB of federal source files (regenerated by `npm run pipeline`)
/pipeline/cache/
# cleaned per-source tables, rebuilt from the cache
/pipeline/clean/

# Boundary tiles are built by `npm run tiles` and served from public/.
# Too large for git; the refresh-data workflow regenerates them.
/public/tiles/

# typescript
*.tsbuildinfo
next-env.d.ts
